# =============================================================================
# IMR IMPRESSÃO 3D - VARIÁVEIS DE AMBIENTE (PRODUÇÃO / DOKPLOY)
# =============================================================================

# Porta HTTP do servidor Express (Padrão Dokploy: 3000)
PORT=3000

# Ambiente de execução (production para máxima performance do Express)
NODE_ENV=production

# Caminho do executável Python (No container Docker Linux: python3 | No Windows local: python)
PYTHON_PATH=python3
